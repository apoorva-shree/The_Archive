<%- include('../partials/header', {
  pageTitle: 'Admin Central Console',
  headerTitle: 'Administrator Central Console',
  headerSubtitle: 'Overview of library inventory, circulation activity, and member requests',
  isAppLayout: true,
  currentPage: 'dashboard'
}) %>

<!-- Statistics Overview Cards -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-card-icon icon-blue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
    </div>
    <div class="stat-card-data">
      <h3><%= (stats.total_copies || 0).toLocaleString() %></h3>
      <p>Total Book Volumes (<%= stats.total_titles || 0 %> Titles)</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-icon icon-emerald">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
    </div>
    <div class="stat-card-data">
      <h3><%= (stats.available_copies || 0).toLocaleString() %></h3>
      <p>Available on Shelves</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-icon icon-purple">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
    </div>
    <div class="stat-card-data">
      <h3><%= (stats.total_students || 0).toLocaleString() %></h3>
      <p>Registered Students</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-icon icon-blue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line></svg>
    </div>
    <div class="stat-card-data">
      <h3><%= (stats.currently_issued || 0).toLocaleString() %></h3>
      <p>Books Currently on Loan</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-icon icon-rose">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
    </div>
    <div class="stat-card-data">
      <h3><%= (stats.overdue_count || 0).toLocaleString() %></h3>
      <p>Overdue Books Pending Return</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-icon icon-amber">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
    </div>
    <div class="stat-card-data">
      <h3><%= (stats.pending_requests || 0).toLocaleString() %></h3>
      <p>Pending Borrow Requests</p>
    </div>
  </div>
</div>

<!-- Quick Action Shortcuts Bar -->
<div class="content-card" style="margin-bottom: 24px;">
  <div class="card-header">
    <h2>Administrative Quick Actions</h2>
  </div>
  <div class="card-body" style="display: flex; gap: 12px; flex-wrap: wrap;">
    <a href="/admin/books/add" class="btn btn-success">+ Add New Book</a>
    <a href="/admin/circulation/issue" class="btn btn-primary">+ Issue Book Directly</a>
    <a href="/admin/borrow-requests" class="btn btn-warning">Manage Borrow Requests (<%= stats.pending_requests || 0 %>)</a>
    <a href="/admin/circulation/overdue" class="btn btn-danger">Overdue Tracker (<%= stats.overdue_count || 0 %>)</a>
    <a href="/admin/books" class="btn btn-secondary">Catalog Management</a>
    <a href="/admin/students" class="btn btn-secondary">Student Accounts</a>
    <a href="/admin/transactions" class="btn btn-secondary">Audit Ledger</a>
  </div>
</div>

<!-- Two-Column Grid: Recent Requests & Recent Issues -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(460px, 1fr)); gap: 24px;">
  <!-- Pending Borrow Requests -->
  <div class="content-card">
    <div class="card-header">
      <h2>Recent Borrow Requests (<%= recent_requests.length %> Pending)</h2>
      <a href="/admin/borrow-requests" class="btn btn-sm btn-secondary">View All &rarr;</a>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Student</th>
            <th>Book Title</th>
            <th>Stock</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (recent_requests.length === 0) { %>
            <tr>
              <td colspan="4" style="text-align: center; padding: 24px; color: #64748b;">
                Zero pending borrow requests at this time.
              </td>
            </tr>
          <% } else { %>
            <% recent_requests.forEach(function(req) { %>
              <tr>
                <td>
                  <div style="font-weight: 600;"><%= req.full_name %></div>
                  <div style="font-size: 0.78rem; color: #64748b;"><%= req.student_id_number %></div>
                </td>
                <td>
                  <div style="font-weight: 600;"><%= req.title %></div>
                  <div style="font-size: 0.78rem; color: #64748b;">by <%= req.author %></div>
                </td>
                <td>
                  <% if (req.available_copies > 0) { %>
                    <span class="badge badge-success"><%= req.available_copies %> Left</span>
                  <% } else { %>
                    <span class="badge badge-danger">Out</span>
                  <% } %>
                </td>
                <td>
                  <div style="display: flex; gap: 4px;">
                    <a href="/admin/borrow-requests/<%= req.id %>/approve" class="btn btn-sm btn-success" style="padding: 4px 8px; font-size: 0.75rem;" onclick="return confirm('Approve request and issue book?');">
                      Approve
                    </a>
                    <a href="/admin/borrow-requests/<%= req.id %>/reject" class="btn btn-sm btn-danger" style="padding: 4px 8px; font-size: 0.75rem;" onclick="return confirm('Reject this request?');">
                      Reject
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recently Issued Books -->
  <div class="content-card">
    <div class="card-header">
      <h2>Active Circulation (<%= recent_issued.length %> Recent)</h2>
      <a href="/admin/circulation/issued" class="btn btn-sm btn-secondary">View All &rarr;</a>
    </div>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Student</th>
            <th>Book Title</th>
            <th>Issue Date</th>
            <th>Due Date</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (recent_issued.length === 0) { %>
            <tr>
              <td colspan="5" style="text-align: center; padding: 24px; color: #64748b;">
                No books currently on loan.
              </td>
            </tr>
          <% } else { %>
            <% recent_issued.forEach(function(iss) { %>
              <% 
                const issueDateStr = iss.issue_date ? (iss.issue_date.toISOString ? iss.issue_date.toISOString().substring(0, 10) : String(iss.issue_date).substring(0, 10)) : '';
                const dueDateStr = iss.due_date ? (iss.due_date.toISOString ? iss.due_date.toISOString().substring(0, 10) : String(iss.due_date).substring(0, 10)) : '';
              %>
              <tr>
                <td>
                  <div style="font-weight: 600;"><%= iss.full_name %></div>
                  <div style="font-size: 0.78rem; color: #64748b;"><%= iss.student_id_number %></div>
                </td>
                <td>
                  <div style="font-weight: 600;"><%= iss.title %></div>
                  <div style="font-size: 0.78rem; color: #64748b;">by <%= iss.author %></div>
                </td>
                <td><span style="font-size: 0.85rem;"><%= issueDateStr %></span></td>
                <td><strong style="font-size: 0.85rem; color: #b45309;"><%= dueDateStr %></strong></td>
                <td>
                  <a href="/admin/circulation/return/<%= iss.id %>" class="btn btn-sm btn-primary" style="padding: 4px 8px; font-size: 0.75rem;">
                    Return &rarr;
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer', { isAppLayout: true }) %>
