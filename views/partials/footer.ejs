<% if (typeof isAppLayout !== 'undefined' && isAppLayout) { %>
    </main> <!-- end .page-body -->
  </div> <!-- end .main-content -->
</div> <!-- end .app-container -->
<% } else { %>
  <!-- Public Footer for Landing Page / General Pages -->
