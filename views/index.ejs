<%- include('partials/header', { pageTitle: 'Where Learning Goes Beyond Classrooms', isAppLayout: false }) %>

<!-- Public Navigation Bar -->
<header class="public-navbar">
  <div class="nav-container">
    <a href="/" class="brand-logo">
      <div class="brand-icon-gold">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
      </div>
      <div class="brand-title-group">
        <span class="brand-title">THE ARCHIVE</span>
        <span class="brand-sub">IIIT KOTA · DIGITAL LIBRARY</span>
      </div>
    </a>

    <ul class="nav-links">
      <li><a href="#about">About</a></li>
      <li><a href="#categories">Departments</a></li>
      <li><a href="#catalog">Featured Volumes</a></li>
      <li><a href="#features">Why The Archive</a></li>
    </ul>

    <div class="nav-actions">
      <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin/dashboard" class="btn btn-gold">Admin Console &rarr;</a>
        <% } else { %>
          <a href="/student/dashboard" class="btn btn-gold">Student Dashboard &rarr;</a>
        <% } %>
      <% } else { %>
        <a href="/login" class="btn btn-outline">Sign In</a>
        <a href="/register" class="btn btn-gold">Student Register</a>
      <% } %>
    </div>
  </div>
</header>

<!-- Hero Section -->
<section class="hero-section" id="about">
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-institution-badge">
        <span>&#9733;</span> IIIT KOTA · DIGITAL LIBRARY
      </div>
      <h1 class="hero-title">
        Where Learning Goes <span>Beyond Classrooms.</span>
      </h1>
      <p class="hero-desc">
        Your gateway to knowledge, discovery and academic excellence. Access research texts, syllabus volumes, and streamlined circulation tailored for IIIT Kota scholars.
      </p>

      <div class="hero-tags">
        <span class="tag-chip">Discover</span>
        <span class="tag-chip">Learn</span>
        <span class="tag-chip">Explore</span>
      </div>

      <div class="hero-cta">
        <a href="#catalog" class="btn btn-lg btn-gold">Explore Books</a>
        <% if (typeof currentUser === 'undefined' || !currentUser) { %>
          <a href="/register" class="btn btn-lg btn-outline">Create Student Account</a>
        <% } %>
      </div>

      <!-- Real-Time Dynamic Library Stats Banner -->
      <div class="hero-stats-banner">
        <div class="stat-item">
          <h3><%= (stats.total_books_count || 0).toLocaleString() %>+</h3>
          <p>Total Book Volumes</p>
        </div>
        <div class="stat-item">
          <h3><%= (stats.available_copies_count || 0).toLocaleString() %></h3>
          <p>Available on Shelves</p>
        </div>
        <div class="stat-item">
          <h3><%= (stats.members_count || 0).toLocaleString() %>+</h3>
          <p>Enrolled Scholars</p>
        </div>
      </div>
    </div>

    <div class="hero-preview">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
        <span style="font-size: 0.82rem; font-weight: 700; color: #dfba66; text-transform: uppercase; letter-spacing: 1px;">IIIT Kota Circulation</span>
        <span class="badge badge-success">Digital Desk Online</span>
      </div>
      <div style="background: rgba(15, 27, 45, 0.65); padding: 18px; border-radius: 8px; border: 1px solid rgba(229, 225, 216, 0.12); margin-bottom: 14px;">
        <div style="font-weight: 700; color: #fff; margin-bottom: 4px;">Direct Borrow Reservations</div>
        <div style="font-size: 0.85rem; color: #cbd5e1;">Students can submit book borrow requests online. Instant verification and zero queue time at the circulation counter.</div>
      </div>
      <div style="background: rgba(15, 27, 45, 0.65); padding: 18px; border-radius: 8px; border: 1px solid rgba(229, 225, 216, 0.12); margin-bottom: 14px;">
        <div style="font-weight: 700; color: #fff; margin-bottom: 4px;">Automated Deadlines &amp; Ledger</div>
        <div style="font-size: 0.85rem; color: #cbd5e1;">Configured 14-day loan periods with automated overdue detection and transparent daily fee accounting.</div>
      </div>
      <div style="text-align: center; margin-top: 18px;">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a href="<%= currentUser.role === 'admin' ? '/admin/dashboard' : '/student/books' %>" class="btn btn-block btn-gold">
            Go to Portal &rarr;
          </a>
        <% } else { %>
          <a href="/login" class="btn btn-block btn-gold">Sign In to Request Books</a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<!-- Featured Categories Section -->
<section class="section" id="categories">
  <div class="section-header">
    <div class="section-tag">Academic Disciplines</div>
    <h2 class="section-title">Explore by Department &amp; Subject</h2>
    <p class="section-desc">
      Our repository spans comprehensive collections curated across major engineering, science, computing, and humanities curricula.
    </p>
  </div>

  <div class="category-grid">
    <% categories.forEach(function(cat) { %>
      <div class="category-card">
        <div class="category-icon">&#128214;</div>
        <h3><%= cat.name %></h3>
        <p><%= cat.description %></p>
        <div style="margin-top: 16px;">
          <a href="<%= (typeof currentUser !== 'undefined' && currentUser) ? '/student/books?category=' + cat.id : '/login' %>" class="btn btn-sm btn-outline-primary">
            Browse Department &rarr;
          </a>
        </div>
      </div>
    <% }); %>
  </div>
</section>

<!-- Featured Books Catalog Preview -->
<section class="section" id="catalog" style="background: var(--bg-subtle); max-width: 100%; border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 20px;">
    <div class="section-header">
      <div class="section-tag">Library Catalog</div>
      <h2 class="section-title">Featured Academic Volumes</h2>
      <p class="section-desc">
        Explore popular reference textbooks, lab manuals, and research foundations available for issue.
      </p>
    </div>

    <div class="book-grid">
      <% featured_books.forEach(function(book) { %>
        <% 
          let coverSrc = '/assets/images/covers/default_book.svg';
          if (book.cover_image) {
            coverSrc = '/assets/images/covers/' + book.cover_image;
          }
        %>
        <div class="book-card">
          <div class="book-cover-wrap">
            <img src="<%= coverSrc %>" alt="<%= book.title %>" class="book-cover-img">
            <div class="book-badge-pos">
              <% if (book.available_copies > 0) { %>
                <span class="badge badge-success">Available (<%= book.available_copies %>)</span>
              <% } else { %>
                <span class="badge badge-danger">Out of Stock</span>
              <% } %>
            </div>
          </div>
          <div class="book-content">
            <div class="book-category"><%= book.category_name %></div>
            <h4 class="book-title" title="<%= book.title %>"><%= book.title %></h4>
            <div class="book-author">By <%= book.author %></div>
            <div class="book-meta">
              <span class="copies-info">ISBN: <%= (book.isbn || '').substring(0, 13) %></span>
              <a href="<%= (typeof currentUser !== 'undefined' && currentUser) ? '/student/books/' + book.id : '/login' %>" class="btn btn-sm btn-outline-primary">
                Details
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <div style="text-align: center; margin-top: 40px;">
      <a href="<%= (typeof currentUser !== 'undefined' && currentUser) ? '/student/books' : '/login' %>" class="btn btn-lg btn-primary">
        View Entire Catalog in Portal &rarr;
      </a>
    </div>
  </div>
</section>

<!-- Why Choose Our Library Section -->
<section class="section" id="features">
  <div class="section-header">
    <div class="section-tag">Modern System Architecture</div>
    <h2 class="section-title">Why Choose Our Library Portal?</h2>
    <p class="section-desc">
      Architected for seamless academic workflows with complete transparency and real-time ledger accounting.
    </p>
  </div>

  <div class="features-grid">
    <div class="feature-card">
      <div class="feature-icon icon-blue">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
      </div>
      <h3>Real-Time Catalog Search</h3>
      <p>Instantly search by title, author, or ISBN across all engineering and science departments with live stock indicators.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon icon-emerald">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <h3>Zero-Queue Digital Reservations</h3>
      <p>Reserve volumes directly from your scholar dashboard. Pick up your physical copy with instant administrator verification.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon icon-amber">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
      </div>
      <h3>Transparent Fine Accounting</h3>
      <p>Automated overdue detection with fixed ₹5.00/day policy. Track accumulated fines and clearance history with full transparency.</p>
    </div>

    <div class="feature-card">
      <div class="feature-icon icon-purple">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      </div>
      <h3>Immutable Audit Ledger</h3>
      <p>Every borrow request, approval, rejection, issue, and return event is permanently logged into an audit trail.</p>
    </div>
  </div>
</section>

<%- include('partials/footer', { isAppLayout: false }) %>
