<%- include('../partials/header', {
  pageTitle: book.title,
  headerTitle: 'Book Details & Circulation',
  headerSubtitle: 'Review syllabus references and submit borrowing requests',
  isAppLayout: true,
  currentPage: 'books'
}) %>

<div style="margin-bottom: 20px;">
  <a href="/student/books" class="btn btn-sm btn-secondary">&larr; Back to Catalog</a>
</div>

<div class="content-card">
  <div class="card-body">
    <div class="book-detail-grid">
      <!-- Left Column: Cover & Stock Badge -->
      <div>
        <% 
          let coverPath = '/assets/images/covers/default_book.svg';
          if (book.cover_image) {
            coverPath = '/assets/images/covers/' + book.cover_image;
          }
        %>
        <img src="<%= coverPath %>" alt="<%= book.title %>" class="detail-cover">
        <div style="text-align: center; margin-top: 16px;">
          <% if (book.available_copies > 0) { %>
            <span class="badge badge-success" style="font-size: 0.85rem; padding: 6px 14px;">
              &#10003; <%= book.available_copies %> of <%= book.total_copies %> Copies Available
            </span>
          <% } else { %>
            <span class="badge badge-danger" style="font-size: 0.85rem; padding: 6px 14px;">
              &#10007; Currently Out of Stock
            </span>
          <% } %>
        </div>
      </div>

      <!-- Right Column: Metadata & Request Submission -->
      <div>
        <span class="badge badge-neutral" style="margin-bottom: 10px;"><%= book.category_name %></span>
        <h1 style="font-size: 1.6rem; font-weight: 800; color: #0f172a; margin-bottom: 6px; line-height: 1.3;">
          <%= book.title %>
        </h1>
        <div style="font-size: 1rem; color: #475569; margin-bottom: 18px;">
          Authored by <strong><%= book.author %></strong>
        </div>

        <div class="detail-meta-list" style="margin-bottom: 24px;">
          <div class="meta-item">
            <span class="meta-label">ISBN</span>
            <span class="meta-val"><code><%= book.isbn %></code></span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Publisher</span>
            <span class="meta-val"><%= book.publisher || 'N/A' %></span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Publication Year</span>
            <span class="meta-val"><%= book.publication_year %></span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Standard Loan Duration</span>
            <span class="meta-val">14 Calendar Days</span>
          </div>
        </div>

        <div style="margin-bottom: 28px;">
          <h3 style="font-size: 1rem; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Synopsis &amp; Description</h3>
          <p style="color: #475569; line-height: 1.7; font-size: 0.95rem;">
            <%= book.description || 'No detailed overview has been published for this academic text yet. Refer to syllabus reference guides.' %>
          </p>
        </div>

        <!-- Borrow Request Action Box -->
        <div style="background: var(--bg-subtle); padding: 20px; border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
          <% if (userBorrowStatus.hasActiveIssue) { %>
            <div class="alert alert-info" style="margin-bottom: 0;">
              <strong>Active Circulation:</strong> You currently have an active borrowed copy of this book on loan (Due: <%= new Date(userBorrowStatus.activeIssue.due_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %>). Please return your current copy before submitting another reservation.
            </div>
          <% } else if (userBorrowStatus.hasPendingRequest) { %>
            <div class="alert alert-warning" style="margin-bottom: 0;">
              <strong>Request Under Review:</strong> You already have a pending borrow request submitted for this book. The central library staff will process it shortly.
            </div>
          <% } else if (book.available_copies <= 0) { %>
            <div class="alert alert-danger" style="margin-bottom: 0;">
              <strong>Inventory Notice:</strong> All copies of this book are currently on loan. Please check back when books are returned to shelves.
            </div>
          <% } else { %>
            <form method="POST" action="/student/borrow-requests">
              <input type="hidden" name="book_id" value="<%= book.id %>">
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px;">
                <div>
                  <div style="font-weight: 700; color: #0f172a;">Reserve This Book Online</div>
                  <div style="font-size: 0.85rem; color: #64748b;">14-day loan period upon administrator collection approval.</div>
                </div>
                <button type="submit" class="btn btn-primary btn-lg" onclick="return confirm('Confirm borrow request for this book?');">
                  Submit Borrow Request &rarr;
                </button>
              </div>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer', { isAppLayout: true }) %>
