<%- include('../partials/header', {
  pageTitle: 'Student Dashboard',
  headerTitle: 'Welcome, ' + currentUser.full_name,
  headerSubtitle: 'Your university library account summary and active reading portfolio',
  isAppLayout: true,
  currentPage: 'dashboard'
}) %>

<!-- Student Metrics Grid -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-card-icon icon-blue">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
    </div>
    <div class="stat-card-data">
      <h3><%= metrics.active_loans_count %></h3>
      <p>Books Currently Borrowed</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-icon icon-amber">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
    </div>
    <div class="stat-card-data">
      <h3><%= metrics.pending_requests_count %></h3>
      <p>Pending Borrow Requests</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-icon icon-emerald">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
    </div>
    <div class="stat-card-data">
      <h3><%= metrics.returned_count %></h3>
      <p>Books Returned (Completed)</p>
    </div>
  </div>

  <div class="stat-card">
    <div class="stat-card-icon icon-rose">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="7.86 2 16.14 2 22 7.86 22 16.14 16.14 22 7.86 22 2 16.14 2 7.86 7.86 2"></polygon><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
    </div>
    <div class="stat-card-data">
      <h3><%= metrics.overdue_count %></h3>
      <p>Overdue Books</p>
    </div>
  </div>
</div>

<!-- Active Borrowed Books Table -->
<div class="content-card">
  <div class="card-header">
    <h2>My Active Book Loans (<%= active_books.length %>)</h2>
    <a href="/student/books" class="btn btn-sm btn-primary">+ Borrow Another Book</a>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Cover</th>
          <th>Book Title &amp; Details</th>
          <th>Category</th>
          <th>Issue Date</th>
          <th>Due Date</th>
          <th>Status</th>
          <th>Days Left</th>
        </tr>
      </thead>
      <tbody>
        <% if (active_books.length === 0) { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 36px; color: #64748b;">
              You currently have no books checked out from the central library.
            </td>
          </tr>
        <% } else { %>
          <% active_books.forEach(function(b) { %>
            <% 
              let coverSrc = '/assets/images/covers/default_book.svg';
              if (b.cover_image) {
                coverSrc = '/assets/images/covers/' + b.cover_image;
              }
              const isOverdue = (new Date(b.due_date).getTime() < new Date().setHours(0,0,0,0));
              const daysLeft = Math.ceil((new Date(b.due_date).getTime() - new Date().setHours(0,0,0,0)) / (1000 * 60 * 60 * 24));
            %>
            <tr>
              <td style="width: 50px;">
                <img src="<%= coverSrc %>" alt="Cover" style="width: 44px; height: 60px; object-fit: cover; border-radius: 4px;">
              </td>
              <td>
                <div style="font-weight: 700; color: #0f172a;"><%= b.title %></div>
                <div style="font-size: 0.8rem; color: #64748b;">by <%= b.author %></div>
                <div style="font-size: 0.75rem; color: #94a3b8;">ISBN: <%= b.isbn %></div>
              </td>
              <td><span class="badge badge-neutral"><%= b.category_name %></span></td>
              <td><%= new Date(b.issue_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
              <td>
                <div style="font-weight: 700;"><%= new Date(b.due_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></div>
              </td>
              <td>
                <% if (isOverdue) { %>
                  <span class="badge badge-danger">Overdue</span>
                <% } else { %>
                  <span class="badge badge-success">Active Loan</span>
                <% } %>
              </td>
              <td>
                <% if (isOverdue) { %>
                  <strong style="color: #ef4444;"><%= Math.abs(daysLeft) %> days late</strong>
                <% } else { %>
                  <span style="color: #10b981; font-weight: 600;"><%= daysLeft %> days left</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Recent Borrow Requests -->
<div class="content-card">
  <div class="card-header">
    <h2>Recent Borrow Requests (<%= my_requests.length %>)</h2>
    <a href="/student/loan-history" class="btn btn-sm btn-secondary">Full Request Log &rarr;</a>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Request ID</th>
          <th>Book Title &amp; Author</th>
          <th>Submission Date</th>
          <th>Status</th>
          <th>Remarks</th>
        </tr>
      </thead>
      <tbody>
        <% if (my_requests.length === 0) { %>
          <tr>
            <td colspan="5" style="text-align: center; padding: 24px; color: #64748b;">
              You have not submitted any borrow requests recently.
            </td>
          </tr>
        <% } else { %>
          <% my_requests.forEach(function(r) { %>
            <tr>
              <td><strong>#BR-<%= r.id %></strong></td>
              <td>
                <div style="font-weight: 600;"><%= r.title %></div>
                <div style="font-size: 0.78rem; color: #64748b;">by <%= r.author %></div>
              </td>
              <td><%= new Date(r.request_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              <td>
                <% if (r.status === 'pending') { %>
                  <span class="badge badge-warning">Awaiting Review</span>
                <% } else if (r.status === 'approved') { %>
                  <span class="badge badge-success">Approved</span>
                <% } else { %>
                  <span class="badge badge-danger">Declined</span>
                <% } %>
              </td>
              <td style="font-size: 0.82rem; color: #64748b;">
                <%= r.admin_notes || '—' %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer', { isAppLayout: true }) %>
