<%- include('../partials/header', {
  pageTitle: 'Borrowing History',
  headerTitle: 'My Borrowing & Circulation History',
  headerSubtitle: 'Complete record of your past book loans, returns, and request approvals',
  isAppLayout: true,
  currentPage: 'borrow_history'
}) %>

<!-- Past Returned Loans -->
<div class="content-card">
  <div class="card-header">
    <h2>Returned Books History (<%= pastLoans.length %> Total)</h2>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Issue ID</th>
          <th>Book Title &amp; Author</th>
          <th>Category</th>
          <th>Issue Date</th>
          <th>Due Date</th>
          <th>Return Date</th>
          <th>Status</th>
          <th>Fine Paid</th>
        </tr>
      </thead>
      <tbody>
        <% if (pastLoans.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 36px; color: #64748b;">
              You have not returned any books yet.
            </td>
          </tr>
        <% } else { %>
          <% pastLoans.forEach(function(book) { %>
            <% 
              const fineAmount = parseFloat(book.fine_amount) || 0;
            %>
            <tr>
              <td><strong>#IB-<%= book.id %></strong></td>
              <td>
                <div style="font-weight: 700; color: #0f172a;"><%= book.title %></div>
                <div style="font-size: 0.8rem; color: #64748b;">by <%= book.author %></div>
              </td>
              <td><span class="badge badge-neutral"><%= book.category_name %></span></td>
              <td><%= new Date(book.issue_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
              <td><%= new Date(book.due_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
              <td>
                <strong style="color: #10b981;">
                  <%= book.return_date ? new Date(book.return_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '' %>
                </strong>
              </td>
              <td><span class="badge badge-success">Returned</span></td>
              <td>
                <% if (fineAmount > 0) { %>
                  <span style="color: #ef4444; font-weight: 600;">₹<%= fineAmount.toFixed(2) %></span>
                <% } else { %>
                  <span style="color: #10b981;">₹0.00 (On Time)</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- All Requests History -->
<div class="content-card">
  <div class="card-header">
    <h2>All Borrow Requests (<%= requestsHistory.length %> Total)</h2>
  </div>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Request ID</th>
          <th>Book Title</th>
          <th>Author</th>
          <th>ISBN</th>
          <th>Request Date</th>
          <th>Status</th>
          <th>Administrator Remarks</th>
        </tr>
      </thead>
      <tbody>
        <% if (requestsHistory.length === 0) { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 36px; color: #64748b;">
              No borrow requests found in your account history.
            </td>
          </tr>
        <% } else { %>
          <% requestsHistory.forEach(function(req) { %>
            <tr>
              <td><strong>#BR-<%= req.id %></strong></td>
              <td style="font-weight: 600;"><%= req.title %></td>
              <td><%= req.author %></td>
              <td><code><%= req.isbn %></code></td>
              <td><%= new Date(req.request_date).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
              <td>
                <% if (req.status === 'pending') { %>
                  <span class="badge badge-warning">Pending</span>
                <% } else if (req.status === 'approved') { %>
                  <span class="badge badge-success">Approved</span>
                <% } else { %>
                  <span class="badge badge-danger">Rejected</span>
                <% } %>
              </td>
              <td style="font-size: 0.85rem; color: #64748b;">
                <%= req.admin_notes || '—' %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer', { isAppLayout: true }) %>
